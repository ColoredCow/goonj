BASE_URL_ADMIN_SITE: 'https://goonj.test/wp-admin'
BASE_URL_USER_SITE: 'https://goonj.test'
USERNAME: ''
PASSWORD: ''

# --- QA checks (tests/qa) ----------------------------------------------------
# Never point these at production. The client refuses to run if it sees crm.goonj.org.
CIVI_BASE_URL=https://staging-crm.goonj.org
CIVI_API_KEY=
# Override only if APIv4 is not at the default path.
CIVI_API_PATH=/civicrm/ajax/api4
# Razorpay webhook receiver. Confirm the real path in
# wp-content/civi-extensions/civirazorpay/CRM/Core/Civirazorpay/Payment/Razorpay.php
# before running the webhook checks (MON-002, MON-003).
CIVI_WEBHOOK_PATH=